---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"textarea"> {}

const { class: className, ...props } = Astro.props;
---

<textarea
  class:list={[
    "min-h-34 w-full resize-y border-0 border-b border-site-rule bg-transparent py-3 text-base font-normal text-site-ink outline-none transition-colors placeholder:text-[color-mix(in_oklch,var(--color-ink-2)_70%,transparent)] hover:border-site-muted focus:border-site-accent focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-site-focus focus-visible:outline-offset-4 disabled:cursor-not-allowed disabled:border-site-rule disabled:bg-site-alt disabled:text-site-muted disabled:opacity-55",
    className,
  ]}
  {...props}></textarea>
