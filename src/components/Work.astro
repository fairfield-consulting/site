---
import ProjectCard from "~/components/ProjectCard.astro";
import {
  featuredProjectSlug,
  featuredProjectTitle,
  hideFeaturedProject,
} from "~/content/featured-project";
---

<section id="work" class="pt-8 pb-28 max-md:pt-6 max-md:pb-18">
  <h2
    class="max-w-[11ch] min-w-0 m-0 wrap-anywhere font-editorial text-section text-site-ink"
  >
    Selected work
  </h2>
  <div class="mt-18 max-md:mt-8">
    {
      !hideFeaturedProject && (
        <article class="border-b border-site-rule py-8 md:p-12 lg:px-16 lg:py-18">
          <h3 class="max-w-[20ch] min-w-0 m-0 wrap-anywhere font-editorial text-[clamp(1.9rem,3vw,3.25rem)] leading-none font-[480] tracking-[-0.045em] text-site-ink">
            {featuredProjectTitle}
          </h3>
          <p class="max-w-xl mt-6 mb-0 text-[0.9375rem] leading-[1.65] text-site-muted">
            This editorial preview reserves space for an approved website
            project. It is not a published client story and contains no confirmed
            project details or outcomes.
          </p>
          <a
            href={`/work/${featuredProjectSlug}/`}
            class="mt-8 inline-flex items-center whitespace-nowrap text-sm font-bold text-site-accent no-underline transition-colors hover:text-site-accent-strong focus-visible:outline-2 focus-visible:outline-site-focus focus-visible:outline-offset-4"
          >
            Read editorial preview
          </a>
        </article>
      )
    }
    <ProjectCard
      title="Internal Tooling for an AI Restaurant Tech Company"
      description="I built internal admin tools for a Y Combinator-backed company that automates restaurant ordering. I also established React and TypeScript patterns to help new engineers get started."
      tags={["React", "TypeScript", "Next.js", "Internal Tools"]}
      link={{ href: "https://of.one", label: "Visit of.one" }}
      imagePosition="right"
    >
      <div
        slot="visual"
        class="flex h-full min-h-inherit items-center justify-center bg-site-image-deep p-8 md:p-10 lg:p-12 xl:p-16"
      >
        <div
          class="relative w-full [box-shadow:1.25rem_1.25rem_0_color-mix(in_oklch,var(--color-accent)_25%,transparent)]"
        >
          <img
            src="/images/work/of-one-admin-tool.png"
            alt="Admin dashboard interface showing enterprise management"
            class="block w-full rounded-xs border border-[color-mix(in_oklch,var(--color-ink)_20%,transparent)]"
          />
        </div>
      </div>
    </ProjectCard>

    <ProjectCard
      title="Engineering Enablement for a Civic Tech Nonprofit"
      description="I worked with engineers at a Michigan nonprofit building apps that connect communities. I provided hands-on mentorship in TypeScript, React, and Next.js."
      tags={["TypeScript", "React", "Next.js", "Mentorship", "Code Review"]}
      link={{
        href: "https://reciprocityapps.org",
        label: "Visit reciprocityapps.org",
      }}
      imagePosition="left"
    >
      <div
        slot="visual"
        class="flex h-full min-h-inherit items-center justify-center bg-site-alt p-8 md:p-10 lg:p-12 xl:p-16"
      >
        <img
          src="/images/work/reciprocity-logo.png"
          alt="ReciprocityApps logo"
          class="h-auto w-[min(12rem,66%)]"
        />
      </div>
    </ProjectCard>
  </div>
</section>
