---
import ProjectCard from "~/components/ProjectCard.astro";
import {
  featuredProjectSlug,
  featuredProjectTitle,
  hideFeaturedProject,
} from "~/content/featured-project";
---

<section id="work" class="pt-8 pb-16 max-md:pt-6 max-md:pb-12">
  <h2
    class="max-w-[11ch] min-w-0 m-0 wrap-anywhere font-editorial text-section text-site-ink"
  >
    Selected work
  </h2>
  <div class="mt-12 max-md:mt-8">
    {
      !hideFeaturedProject && (
        <article class="border-b border-site-rule py-8 md:p-12 lg:px-16 lg:py-18">
          <h3 class="max-w-[20ch] min-w-0 m-0 wrap-anywhere font-editorial text-[clamp(1.9rem,3vw,3.25rem)] leading-none font-[480] tracking-[-0.045em] text-site-ink">
            {featuredProjectTitle}
          </h3>
          <p class="max-w-xl mt-6 mb-0 text-[0.9375rem] leading-[1.65] text-site-muted">
            This editorial preview reserves space for an approved website
            project. It is not a published client story and contains no confirmed
            project details or outcomes.
          </p>
          <a
            href={`/work/${featuredProjectSlug}/`}
            class="mt-8 inline-flex items-center whitespace-nowrap text-sm font-bold text-site-accent no-underline transition-colors hover:text-site-accent-strong focus-visible:outline-2 focus-visible:outline-site-focus focus-visible:outline-offset-4"
          >
            Read editorial preview
          </a>
        </article>
      )
    }
    <ProjectCard
      title="Internal admin tools"
      description="I built admin tools for a restaurant-ordering company and introduced development patterns to help new engineers get started."
      tags={["React", "TypeScript", "Next.js", "Internal Tools"]}
      link={{ href: "https://of.one", label: "Visit of.one" }}
      imagePosition="right"
    >
      <figure slot="visual" class="m-0 flex h-full min-w-0 items-center">
        <a
          href="/images/work/of-one-admin-tool.png"
          class="block w-full no-underline focus-visible:outline-2 focus-visible:outline-site-focus focus-visible:outline-offset-4"
        >
          <div class="bg-site-image-deep p-4 md:p-6">
            <img
              src="/images/work/of-one-admin-tool.png"
              alt="Admin tool showing an enterprise list"
              width="2000"
              height="1362"
              loading="lazy"
              class="block h-auto w-full border border-site-rule"
            />
          </div>
          <span class="mt-3 block text-xs font-semibold whitespace-nowrap text-site-accent">
            View full-size screenshot
          </span>
        </a>
      </figure>
    </ProjectCard>

    <ProjectCard
      title="Engineering mentorship"
      description="I mentored engineers at a Michigan nonprofit building community apps, with hands-on guidance and code review."
      tags={["TypeScript", "React", "Next.js", "Mentorship", "Code Review"]}
      link={{
        href: "https://reciprocityapps.org",
        label: "Visit reciprocityapps.org",
      }}
      imagePosition="left"
    >
      <div
        slot="visual"
        class="flex h-full items-center justify-center bg-site-image-paper p-6"
      >
        <img
          src="/images/work/reciprocity-logo.png"
          alt="ReciprocityApps logo"
          width="300"
          height="300"
          loading="lazy"
          class="h-auto w-32 max-w-full"
        />
      </div>
    </ProjectCard>
  </div>
</section>
