---
import Input from "~/components/Input.astro";
import Label from "~/components/Label.astro";
import Textarea from "~/components/Textarea.astro";
---

<section id="contact" class="py-20 max-md:py-12">
  <div
    class="grid grid-cols-[minmax(0,1.1fr)_minmax(14rem,0.9fr)] gap-12 md:gap-16 lg:gap-20 xl:gap-24 max-md:grid-cols-1"
  >
    <div class="self-start">
      <h2
        class="max-w-[11ch] min-w-0 m-0 wrap-anywhere font-editorial text-section text-site-ink"
      >
        Get in touch
      </h2>
      <p class="mt-6 mb-0 max-w-92 text-body text-site-muted">
        Share your website plans and timeline.
      </p>
    </div>
    <form
      class="grid gap-8"
      name="contact"
      method="POST"
      action="https://formspree.io/f/xwvnljja"
    >
      <input type="hidden" name="form-name" value="contact" />
      <Label for="name">
        Name
        <Input
          type="text"
          id="name"
          name="name"
          required
          autocomplete="given-name"
          placeholder="Your name"
        />
      </Label>
      <Label for="email">
        Email
        <Input
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          required
          placeholder="your@email.com"
        />
      </Label>
      <Label for="message">
        Message
        <Textarea
          id="message"
          name="message"
          placeholder="Your website plans"
          required
          rows="4"
        />
      </Label>
      <button
        type="submit"
        class="mt-4 inline-flex min-h-11.5 cursor-pointer items-center justify-center justify-self-start border border-site-accent bg-site-accent px-6 py-3 text-[0.8125rem] leading-none font-[680] tracking-[0.015em] whitespace-nowrap text-site-accent-ink transition-colors hover:bg-site-accent-strong focus-visible:outline-2 focus-visible:outline-site-focus focus-visible:outline-offset-4 disabled:cursor-not-allowed disabled:border-site-rule disabled:bg-site-alt disabled:text-site-muted disabled:opacity-55"
      >
        Send message
      </button>
    </form>
  </div>
</section>
