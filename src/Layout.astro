---
import "@fontsource-variable/playfair-display";
import "@fontsource-variable/dm-sans";
import "~/global.css";

const includeAnalytics = import.meta.env.PROD;
---

<html
  class="scroll-smooth overflow-x-clip scroll-pt-28 bg-site"
  lang="en"
>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {
      includeAnalytics ? (
        <script
          defer
          src="https://analytics.fairfieldconsulting.llc/script.js"
          data-website-id="d1c4aa75-ec46-4208-9a7e-3d9ece5b9082"
        />
      ) : null
    }
    <title>Fairfield Consulting LLC</title>
    <meta
      name="description"
      content="I build clean, fast websites and web apps for startups and small businesses."
    />
  </head>
  <body
    class="min-w-80 overflow-x-clip bg-site font-site text-body leading-[1.55] text-site-ink [text-rendering:optimizeLegibility]"
  >
    <nav
      class="sticky top-0 z-10 border-b border-site-rule bg-site/95 backdrop-blur"
      aria-label="Primary navigation"
    >
      <div
        class="mx-auto flex min-h-17 w-[min(calc(100%-3rem),72rem)] items-center justify-between gap-8 max-md:min-h-15 max-md:w-[min(calc(100%-2rem),72rem)] max-md:gap-4"
      >
        <a
          href="/"
          class="whitespace-nowrap font-editorial text-lg font-[560] tracking-[-0.035em] text-site-ink no-underline focus-visible:outline-2 focus-visible:outline-site-focus focus-visible:outline-offset-4 max-md:text-[0.9375rem]"
          >Fairfield Consulting</a
        >
        <ul class="m-0 flex list-none items-center gap-8 p-0 max-md:gap-4">
          {
            [
              ["#work", "Work"],
              ["#about", "About"],
              ["#contact", "Contact"],
            ].map(([href, label]) => (
              <li>
                <a
                  href={href}
                  class="whitespace-nowrap text-xs font-[620] tracking-[0.01em] text-site-muted no-underline transition-colors hover:text-site-accent focus-visible:outline-2 focus-visible:outline-site-focus focus-visible:outline-offset-4 max-md:text-[0.6875rem]"
                  >{label}</a
                >
              </li>
            ))
          }
        </ul>
      </div>
    </nav>
    <main
      class="mx-auto w-[min(calc(100%-3rem),72rem)] pb-40 max-md:w-[min(calc(100%-2rem),72rem)]"
    >
      <slot />
    </main>
  </body>
</html>
